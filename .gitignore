# local hygiene — never commit credentials orevaluator data
__pycache__/
*.pyc
.venv/
.DS_Store
.aws/
*.pem
*.key
# fresh run outputs stay local until submission packaging decides otherwise
outputs/*.jsonl
outputs/*.json
# generated min-run viewer data (source viewer ui/minrun/results.html stays tracked)
ui/minrun/results.json
ui/minrun/preview.html
# generated local-MVP viewer data (source viewer ui/minrun/local.html stays tracked)
ui/minrun/local-mvp.json
ui/minrun/preview-local.html
# staged GitHub Pages artifact (built by tools/build_pages.py)
_site/
